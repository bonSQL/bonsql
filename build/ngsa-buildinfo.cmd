@echo off
rem NGSA: pre-build step, writes include\ngsa\NgsaBuildInfo.h with the git commit of the tree being built.
setlocal
set OUT=%~dp0..\include\ngsa\NgsaBuildInfo.h
set COMMIT=unknown
for /f "delims=" %%i in ('git -C "%~dp0.." rev-parse --short HEAD 2^>nul') do set COMMIT=%%i
git -C "%~dp0.." diff --quiet HEAD -- . 2>nul
if errorlevel 1 set DIRTY=+
echo /* generated by build\ngsa-buildinfo.cmd, do not edit, not committed */> "%OUT%"
echo #define NGSA_COMMIT "%COMMIT%%DIRTY%">> "%OUT%"
echo #define NGSA_BUILD_DATE "%DATE%">> "%OUT%"
endlocal
